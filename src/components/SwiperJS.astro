---
import SanityImage from "./SanityImage.astro";

interface Slide {
  asset: {
    url: string;
  };
  caption?: string;
}

interface Props {
  slides: Slide[];
}

const { slides }: Props = Astro.props;
const slidesArray = Array.isArray(slides) ? slides : [];
---

<div class="swiper-body">
  <div class="swiper">
    <div class="swiper-wrapper">
      {
        slidesArray.length > 0 ? slidesArray.map((slide, index) => {
          // Check if slide and asset exist
          if (!slide || !slide.asset) return null;
          
          return (
            <div class="swiper-slide overlay ">
              <SanityImage
                image={slide.asset}
                sizes="100vw"
                alt={slide.caption || `Slide ${index + 1}`}
                class="page__cover"
                sizing="cover"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
              />

              {/* {slide.caption && <p class="swiper-caption">{slide.caption}</p>} */}
            </div>
          );
        }) : null
      }
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button swiper-button-prev"></div>
    <div class="swiper-button swiper-button-next"></div>
    <div class="swiper-scrollbar"></div>
  </div>
</div>

<script src="../utils/slider_simple.js"></script>

<style>
  .swiper-body {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .swiper-button {
    color: var(--neutral-100);
    padding: var(--space-m);
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(1vw);
    /* opacity: 0.2; */
  }

  .swiper-button::after {
    font-size: var(--fontsize-0);
    font-weight: 600;
  }

  .overlay {
    border-image: linear-gradient(hsl(0, 0%, 0%), hsla(0, 0%, 0%, 0)) fill 1;
  }

  :global(.swiper-slide img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
</style>
