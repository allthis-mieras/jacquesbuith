---
export interface Props {
  enabled: boolean;
}

const { enabled } = Astro.props;
---

{enabled && (
  <script>
    import('@sanity/visual-editing').then(({ VisualEditing }) => {
      new VisualEditing({
        studioUrl: '/admin',
        dataset: import.meta.env.PUBLIC_SANITY_DATASET,
        projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
      });
    });
  </script>
)}