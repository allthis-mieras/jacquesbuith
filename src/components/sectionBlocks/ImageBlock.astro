---
import SanityImage from "../SanityImage.astro";

const { image } = Astro.props;
---

{
  image?.asset && (
    <div class="image-block">
      <SanityImage
        image={image}
        sizes="100vw"
        alt={image.alt ?? "Image"}
        class="post__cover"
      />
    </div>
  )
}

<style>
  .image-block img {
    width: 100%;
    height: auto;
  }

  .caption {
    text-align: center;
    font-size: 0.875rem;
    color: #666;
  }
</style>
