---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import Highlight from "../components/Highlight.astro";

import { getHomepage } from "../utils/sanity";
import { getPosts } from "../utils/sanity";

const homepage = await getHomepage();

// Provide fallback values if homepage is not found
const heroText = homepage?.hero?.heroText || "";
const heroSlides = homepage?.hero?.heroSlides || [];
const text = homepage?.highlight?.text || "";
const button = homepage?.highlight?.button || { url: "", label: "" };
const image = homepage?.highlight?.image || null;

console.log("homepage.highlight:", text, button, image);

const posts = await getPosts();
const postsArray = Array.isArray(posts) ? posts : [];
---

<Layout title="Home">
  <Hero heroText={heroText} heroSlides={heroSlides} />

  <section class="posts">
    <div class="container stretch">
      {
        postsArray.length > 0 ? (
          postsArray.map((post) => <Card post={post} />)
        ) : (
          <p>no posts</p>
        )
      }
    </div>
  </section>

  <Highlight text={text} button={button} image={image} />
</Layout>

<style>
  .posts .container {
    padding-block: var(--gap-default);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-2xs);
  }

  @media (min-width: 896px) {
    .posts .container {
      padding: var(--space-3xl) var(--gap-default);
      gap: var(--gap-default);
    }
  }
</style>
